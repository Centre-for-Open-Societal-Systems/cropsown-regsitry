# Database Config
REGISTRY_PARTNER_API_DB_USERNAME="postgres"
REGISTRY_PARTNER_API_DB_PASSWORD="password"
REGISTRY_PARTNER_API_DB_HOSTNAME="localhost"
REGISTRY_PARTNER_API_DB_PORT=5432
REGISTRY_PARTNER_API_DB_DBNAME="registry_db"

# MinIO Config
REGISTRY_PARTNER_API_MINIO_ENDPOINT="localhost:9000"
REGISTRY_PARTNER_API_MINIO_ACCESS_KEY="admin"
REGISTRY_PARTNER_API_MINIO_SECRET_KEY="secret"
REGISTRY_PARTNER_API_MINIO_SECURE="false"
REGISTRY_PARTNER_API_MINIO_BUCKET_NAME="default_bucket"
REGISTRY_PARTNER_API_TEMPLATE_BUCKET_NAME="templates"

# Keymanager Config
REGISTRY_PARTNER_API_KEYMANAGER_API_BASE_URL=""
REGISTRY_PARTNER_API_KEYMANAGER_API_TIMEOUT=10
REGISTRY_PARTNER_API_KEYMANAGER_API_DOMAIN="AUTH"
REGISTRY_PARTNER_API_KEYMANAGER_SSL_VERIFY=False
REGISTRY_PARTNER_API_KEYMANAGER_AUTH_ENABLED=False
REGISTRY_PARTNER_API_KEYMANAGER_AUTH_URL=""
REGISTRY_PARTNER_API_KEYMANAGER_AUTH_CLIENT_ID="openg2p-registry-partner"
REGISTRY_PARTNER_API_KEYMANAGER_AUTH_CLIENT_SECRET=""
REGISTRY_PARTNER_API_KEYMANAGER_SIGN_APP_ID="REGISTRY"
REGISTRY_PARTNER_API_KEYMANAGER_SIGN_REF_ID=""

# Master Data DB Config
REGISTRY_PARTNER_API_MASTER_DATA_DB_DRIVER="postgresql+asyncpg"
REGISTRY_PARTNER_API_MASTER_DATA_DB_USERNAME="postgres"
REGISTRY_PARTNER_API_MASTER_DATA_DB_PASSWORD="your_password"
REGISTRY_PARTNER_API_MASTER_DATA_DB_HOSTNAME="localhost"
REGISTRY_PARTNER_API_MASTER_DATA_DB_PORT=5432
REGISTRY_PARTNER_API_MASTER_DATA_DB_DBNAME="openg2p_gen2_master_data_db"

# OpenG2P Audit Manager integration
# To enable: set both AUDIT_ENABLED=true AND AUDIT_MANAGER_URL.
# Default = disabled / no-op (no audits emitted).
REGISTRY_PARTNER_API_AUDIT_ENABLED="false"
REGISTRY_PARTNER_API_AUDIT_MANAGER_URL=""
REGISTRY_PARTNER_API_AUDIT_TIMEOUT_SECONDS="2.0"
REGISTRY_PARTNER_API_AUDIT_SOURCE="/openg2p/registry-partner-api"
REGISTRY_PARTNER_API_AUDIT_MODULE="registry-partner-api"
# Also audit anonymous-looking calls that get rejected (any non-2xx
# response without controller-supplied actor enrichment). Set to "false"
# to skip anonymous attempts entirely.
REGISTRY_PARTNER_API_AUDIT_ANONYMOUS_FAILURES="true"