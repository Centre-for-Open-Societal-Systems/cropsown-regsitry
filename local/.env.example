# Crop Sown Registry — local development environment.
#
#   cp local/.env.example local/.env
#   docker compose --env-file local/.env up -d --build
#
# Every value here is a local-only credential for the compose stack; nothing
# in it is used by a deployed environment. Browser-facing services publish a
# host port EQUAL to their container port (see local/README.md), so keep
# KEYCLOAK_PORT, IAM_PORT, MINIO_API_PORT and STAFF_UI_PORT as they are.
#
# Usage:
#   cp local/.env.example local/.env
#   docker compose --env-file local/.env up -d --build
#
# Ports baked into local/keycloak/realm-staff.json and local/iam/login_providers.json:
#   STAFF_UI_PORT=3000, IAM_PORT=8000, KEYCLOAK_PORT=8080.
# If you change these ports, update those JSON files to match.

# ── Release & Versioning ──────────────────────────────────────────────────────
RELEASE_NAME=cropsown-registry
RP_VERSION=1.2.2-rc.544

# ── Domain & Cookies ─────────────────────────────────────────────────────────
COOKIE_DOMAIN=localtest.me

# ── Service Hosts & Ports ────────────────────────────────────────────────────
STAFF_UI_HOST=portal.localtest.me
STAFF_UI_PORT=3000

DASHBOARD_UI_HOST=dashboard.localtest.me
DASHBOARD_UI_PORT=3001

STAFF_API_PORT=8001
PARTNER_API_PORT=8002

KEYCLOAK_HOST=keycloak.localtest.me
KEYCLOAK_PORT=8080

IAM_HOST=iam.localtest.me
IAM_PORT=8000

MASTER_DATA_PORT=8010

MINIO_HOST=minio.localtest.me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_PORT=55432
POSTGRES_PASSWORD=postgres

# ── External Base Images ─────────────────────────────────────────────────────
IAM_IMAGE=openg2p/iam-staff-portal-api:1.4.2
# The Ethiopia geo seed (docker/local-dev/geo-seed) writes master-data's newer
# schema (display_name, pcode, ...). The 1.1.x releases on Docker Hub lack those
# columns (with one of them, set LOAD_ETHIOPIA_GEO=false below); develop.69 has
# them and is the same image the farmer local stack runs.
MASTER_DATA_IMAGE=openg2p/master-data-api:0.0.0-develop.69
IDGEN_IMAGE=openg2p/openg2p-id-generator:1.1.2

# ── Keycloak Configuration ───────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=staff
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_pass

# ── IAM Configuration ────────────────────────────────────────────────────────
IAM_DB=iam
IAM_DB_USER=iam_user
IAM_DB_PASSWORD=iam_pass
IAM_CLIENT_SECRET=staff-portal-secret

# ── Auth & OpenID Connect Client ─────────────────────────────────────────────
AUTH_CLIENT_ID=cropsown-staff-portal
AUTH_CLIENT_SECRET=cropsown-staff-portal-secret

# ── Master Data Database ─────────────────────────────────────────────────────
MASTER_DATA_DB=master_data
MASTER_DATA_DB_USER=master_data_user
MASTER_DATA_DB_PASSWORD=master_data_pass

# ── ID Generator Database ────────────────────────────────────────────────────
IDGEN_DB=cropsown_idgenerator
IDGEN_DB_USER=cropsown_idgenerator_user
IDGEN_DB_PASSWORD=cropsown_idgenerator_pass

# ── Registry Database ────────────────────────────────────────────────────────
REGISTRY_DB=cropsown
REGISTRY_DB_USER=cropsown_user
REGISTRY_DB_PASSWORD=cropsown_pass

# ── MinIO Object Storage ─────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
DEFAULT_BUCKET=default
TEMPLATE_BUCKET=templates
DOCUMENTS_BUCKET=documents

# ── DB Seed Options ──────────────────────────────────────────────────────────
LOAD_GEO_DATA=false
LOAD_SAMPLE_DATA=false
LOAD_IMAGES=false
LOAD_TEMPLATES=true

# ── Disabled Integrations (Local Standalone) ─────────────────────────────────
AWE_ENABLED=false
AUDIT_ENABLED=false
PARTNER_SIGNATURE_VALIDATION_ENABLED=false
CONSENT_ENFORCEMENT_ENABLED=false
KEYMANAGER_AUTH_ENABLED=false
CRYPTO_BACKEND=local

# ── Approver Resolver & AWE ──────────────────────────────────────────────────
AWE_CALLBACK_SECRET_ID=awe-secret-id
AWE_CALLBACK_HMAC_SECRET=awe-hmac-secret
APPROVER_RESOLVER_SECRET=approver-resolver-secret

# ── Connector Service ────────────────────────────────────────────────────────
CONNECTOR_PORT=8051
CONNECTOR_UI_PORT=5174
CONNECTOR_DB=connector
CONNECTOR_DB_USER=connector_user
CONNECTOR_DB_PASSWORD=connector_pass

# ── Crop-sown-only db-seed switches ─────────────────────────────────────────
LOAD_ATTRIBUTES=false
SYNC_GEO_WIDGETS=false
ATTRIBUTE_DOMAINS=false
LOAD_ETHIOPIA_GEO=true
# Demo crop sown records (10_/20_/40_/45_ sample-data), needed for dashboard work.
LOAD_CROPSOWN_SAMPLE_DATA=true

# ── Farmer Registry DCI enrichment + two-CR ─────────────────────────────────
# Off by default. Turn on by setting the ENABLED flags and the DCI/consent
# settings below; compose injects these into staff-api + celery-worker.
CROPSOWN_FARMER_ENRICHMENT_ENABLED=false
CROPSOWN_TWO_CR_ENABLED=false
# Full DCI sync-search URL of the Farmer Registry partner-api (no default).
CROPSOWN_FARMER_DCI_URL=
CROPSOWN_FARMER_DCI_TIMEOUT=10
CROPSOWN_DCI_SENDER_ID=cropsown
CROPSOWN_DCI_RECEIVER_ID=farmer-registry
# Partner signing key: either paste the PEM text, OR drop the key file in
# local/secrets/ and point KEY_PATH at it (mounted read-only at /run/secrets/cropsown).
CROPSOWN_CM_SIGNING_KEY_PEM=
CROPSOWN_CM_SIGNING_KEY_PATH=
CROPSOWN_CM_SIGNING_KID=
CROPSOWN_CM_PARTNER_AUD=
CROPSOWN_CM_CONTROLLER_ID=ethiopia-moa
# Must equal the response field read (farmer_personal_details), or scope filtering strips it.
CROPSOWN_CM_SCOPES=farmer_personal_details
CROPSOWN_CM_ALG=EdDSA
CROPSOWN_CM_PURPOSE=share_farm_profile
# Target Farmer register id for the second (Farmer) change-request.
CROPSOWN_FARMER_REGISTER_ID=
# Headless (ODK) ingestion service token — celery-worker raises the Farmer CR with it.
CROPSOWN_ODK_KEYCLOAK_URL=
CROPSOWN_ODK_KEYCLOAK_REALM=
CROPSOWN_ODK_SERVICE_CLIENT_ID=
CROPSOWN_ODK_SERVICE_CLIENT_SECRET=
CROPSOWN_ODK_SERVICE_USERNAME=
CROPSOWN_ODK_SERVICE_PASSWORD=
