{#-
  Crop Sown file import, cultivation intake. One flat row of a CSV or Excel file (every value a string) becomes
  the sections of one cultivation intake. The import worker hands the row over as the business payload, so
  the columns are the register's own field names (docs/file-import.md lists them with their codes).
  A row can also carry up to 3 cultivation clusters (Cultivation cluster details): the cluster_<n>_* columns at the end.
  Others: add them in the staff portal or by change request.
  A value the register cannot take fails this row only, with the column named in the error.
-#}
{% macro fail(message) %}{{ {}[message].invalid }}{% endmacro %}
{% set row = expanded if expanded is defined else {} %}
{% set cell = {} %}
{% for key, raw in row.items() %}{% set _ = cell.update({(key | string | trim | lower): ((raw if raw is not none else '') | string | trim)}) %}{% endfor %}
{#- The columns of import-templates/crop_cultivation_intake_import_template.csv. Any other column fails the row, so a file
    made for another form's import (Planning, Cultivation, Sowing, Harvest) is not taken as this one. -#}
{% set file_columns = ['farmer_id', 'fayda_id', 'crop_year', 'production_season', 'land_id', 'season', 'commodity', 'crop_category', 'local_name', 'scientific_name', 'cultivation_type', 'seed_variety', 'actual_fertilizer_type', 'water_source', 'water_source_method', 'water_source_frequency', 'da_name', 'da_mobile_number', 'supervisor_name', 'supervisor_mobile_number', 'land_area', 'actual_crop_area', 'actual_yield', 'actual_seed_qty', 'actual_fertilizer_qty', 'start_month', 'start_day', 'end_month', 'end_day', 'actual_growth_duration_days', 'start_gc', 'end_gc', 'actual_cultivation_date', 'is_plot_not_registered', 'cropping_system', 'actual_seed_class', 'actual_seed_source', 'land_prep_method', 'is_planning_record_created', 'plot_category', 'ownership_type', 'soil_fertility_type', 'region', 'zone', 'woreda', 'kebele', 'latitude', 'longitude', 'crop_latitude', 'crop_longitude', 'cluster_1_land_id', 'cluster_1_name', 'cluster_1_reference', 'cluster_1_fpc_type', 'cluster_1_season', 'cluster_1_start_gc', 'cluster_1_end_gc', 'cluster_1_establishing_date', 'cluster_1_region', 'cluster_1_zone', 'cluster_1_woreda', 'cluster_1_kebele', 'cluster_1_sub_kebele', 'cluster_1_agro_ecological_zone', 'cluster_1_latitude', 'cluster_1_longitude', 'cluster_1_primary_commodity', 'cluster_1_secondary_commodity', 'cluster_1_area_timad', 'cluster_1_plan', 'cluster_1_collected_land', 'cluster_1_collected_quintal', 'cluster_1_collected_by_combiner', 'cluster_1_number_of_smallholders', 'cluster_1_water_source', 'cluster_1_water_source_method', 'cluster_1_water_source_frequency', 'cluster_1_leader', 'cluster_1_co_leader', 'cluster_1_coordinator', 'cluster_1_secretary', 'cluster_1_da_name', 'cluster_1_da_mobile_number', 'cluster_1_supervisor_name', 'cluster_1_supervisor_mobile_number', 'cluster_2_land_id', 'cluster_2_name', 'cluster_2_reference', 'cluster_2_fpc_type', 'cluster_2_season', 'cluster_2_start_gc', 'cluster_2_end_gc', 'cluster_2_establishing_date', 'cluster_2_region', 'cluster_2_zone', 'cluster_2_woreda', 'cluster_2_kebele', 'cluster_2_sub_kebele', 'cluster_2_agro_ecological_zone', 'cluster_2_latitude', 'cluster_2_longitude', 'cluster_2_primary_commodity', 'cluster_2_secondary_commodity', 'cluster_2_area_timad', 'cluster_2_plan', 'cluster_2_collected_land', 'cluster_2_collected_quintal', 'cluster_2_collected_by_combiner', 'cluster_2_number_of_smallholders', 'cluster_2_water_source', 'cluster_2_water_source_method', 'cluster_2_water_source_frequency', 'cluster_2_leader', 'cluster_2_co_leader', 'cluster_2_coordinator', 'cluster_2_secretary', 'cluster_2_da_name', 'cluster_2_da_mobile_number', 'cluster_2_supervisor_name', 'cluster_2_supervisor_mobile_number', 'cluster_3_land_id', 'cluster_3_name', 'cluster_3_reference', 'cluster_3_fpc_type', 'cluster_3_season', 'cluster_3_start_gc', 'cluster_3_end_gc', 'cluster_3_establishing_date', 'cluster_3_region', 'cluster_3_zone', 'cluster_3_woreda', 'cluster_3_kebele', 'cluster_3_sub_kebele', 'cluster_3_agro_ecological_zone', 'cluster_3_latitude', 'cluster_3_longitude', 'cluster_3_primary_commodity', 'cluster_3_secondary_commodity', 'cluster_3_area_timad', 'cluster_3_plan', 'cluster_3_collected_land', 'cluster_3_collected_quintal', 'cluster_3_collected_by_combiner', 'cluster_3_number_of_smallholders', 'cluster_3_water_source', 'cluster_3_water_source_method', 'cluster_3_water_source_frequency', 'cluster_3_leader', 'cluster_3_co_leader', 'cluster_3_coordinator', 'cluster_3_secretary', 'cluster_3_da_name', 'cluster_3_da_mobile_number', 'cluster_3_supervisor_name', 'cluster_3_supervisor_mobile_number'] %}
{% for key in cell %}{% if key and key not in file_columns %}{{ fail('column ' ~ key ~ ' is not a Cultivation column: check that this file is for the Cultivation import') }}{% endif %}{% endfor %}

{% set farmer_id = cell.get('farmer_id', '') | upper %}
{% if not (farmer_id.startswith('FR-') and farmer_id[3:].isdigit() and farmer_id | length == 15) %}{{ fail('column farmer_id must be FR- followed by 12 digits, got ' ~ farmer_id) }}{% endif %}
{% set fayda_id = cell.get('fayda_id', '') | replace(' ', '') %}
{% if not (fayda_id.isdigit() and fayda_id | length in [12, 16]) %}{{ fail('column fayda_id must be a 16-digit FAN or a 12-digit FIN, got ' ~ fayda_id) }}{% endif %}
{% set crop_year = cell.get('crop_year', '') %}
{% if not (crop_year.isdigit() and crop_year | length == 4) %}{{ fail('column crop_year must be a four-digit year, got ' ~ crop_year) }}{% endif %}
{% set production_season = cell.get('production_season', '') %}
{% if not production_season %}{{ fail('column production_season is required') }}{% endif %}

{% set text_columns = ['land_id', 'plot_category', 'ownership_type', 'soil_fertility_type', 'season', 'commodity', 'crop_category', 'local_name', 'scientific_name', 'cultivation_type', 'seed_variety', 'actual_fertilizer_type', 'water_source', 'water_source_method', 'water_source_frequency', 'da_name', 'da_mobile_number', 'supervisor_name', 'supervisor_mobile_number', 'cropping_system', 'actual_seed_class', 'actual_seed_source'] %}
{% set number_columns = ['land_area', 'actual_crop_area', 'actual_yield', 'actual_seed_qty', 'actual_fertilizer_qty', 'latitude', 'longitude', 'crop_latitude', 'crop_longitude'] %}
{% set integer_columns = ['start_month', 'start_day', 'end_month', 'end_day', 'actual_growth_duration_days'] %}
{% set date_columns = ['start_gc', 'end_gc', 'actual_cultivation_date'] %}
{% set flag_columns = ['is_plot_not_registered', 'is_planning_record_created'] %}
{#- Master Data list columns (cropping system, seed type, seed source, agro-ecological zone) are read as text columns: the registry checks their codes against Master Data. -#}
{% set choice_columns = {} %}
{% set comma_list_columns = ['land_prep_method'] %}
{% set choice_list_columns = {} %}

{% set record = {} %}
{% for key in text_columns %}{% if cell.get(key) %}{% set _ = record.update({key: cell[key]}) %}{% endif %}{% endfor %}
{% for key in number_columns %}{% set value = cell.get(key, '') %}{% if value %}
  {% if not value.replace('.', '', 1).isdigit() %}{{ fail('column ' ~ key ~ ' must be a number, got ' ~ value) }}{% endif %}
  {% set _ = record.update({key: value | float}) %}
{% endif %}{% endfor %}
{% for key in integer_columns %}{% set value = cell.get(key, '') %}{% if value %}
  {% if not value.replace('.', '', 1).isdigit() %}{{ fail('column ' ~ key ~ ' must be a whole number, got ' ~ value) }}{% endif %}
  {% set _ = record.update({key: value | float | int}) %}
{% endif %}{% endfor %}
{% for key in date_columns %}{% set value = cell.get(key, '')[:10] %}{% if value %}
  {% set parts = value.split('-') %}
  {% if not (parts | length == 3 and parts[0] | length == 4 and parts[1] | length == 2 and parts[2] | length == 2 and (parts | join('')).isdigit()) %}{{ fail('column ' ~ key ~ ' must be a date as YYYY-MM-DD, got ' ~ value) }}{% endif %}
  {% set _ = record.update({key: value}) %}
{% endif %}{% endfor %}
{% for key in flag_columns %}{% set value = cell.get(key, '') | lower %}{% if value %}
  {% if value not in ['true', 'yes', '1', 'false', 'no', '0'] %}{{ fail('column ' ~ key ~ ' must be yes or no, got ' ~ value) }}{% endif %}
  {% set _ = record.update({key: value in ['true', 'yes', '1']}) %}
{% endif %}{% endfor %}
{% for key, allowed in choice_columns.items() %}{% set value = cell.get(key, '') | upper %}{% if value %}
  {% if value not in allowed %}{{ fail('column ' ~ key ~ ' must be one of ' ~ allowed | join(', ') ~ ', got ' ~ value) }}{% endif %}
  {% set _ = record.update({key: value}) %}
{% endif %}{% endfor %}
{% for key in comma_list_columns %}{% set values = cell.get(key, '').split(';') | map('trim') | reject('equalto', '') | map('upper') | list %}{% if values %}
  {% set _ = record.update({key: values | join(',')}) %}
{% endif %}{% endfor %}
{% for key, allowed in choice_list_columns.items() %}{% set values = cell.get(key, '').split(';') | map('trim') | reject('equalto', '') | map('upper') | list %}{% if values %}
  {% for value in values %}{% if value not in allowed %}{{ fail('column ' ~ key ~ ' takes ' ~ allowed | join(' and ') ~ ' separated by semicolons, got ' ~ value) }}{% endif %}{% endfor %}
  {% set _ = record.update({key: values}) %}
{% endif %}{% endfor %}
{% if 'season' not in record %}{% set _ = record.update({'season': production_season}) %}{% endif %}
{#- The land's Region, Zone, Woreda and Kebele are Master Data geo unit ids (P-codes); coordinates are stored as text. -#}
{% for level in ['region', 'zone', 'woreda', 'kebele'] %}{% set code = cell.get(level, '') | upper %}{% if code %}{% set _ = record.update({level: code}) %}{% endif %}{% endfor %}
{% for key in ['latitude', 'longitude', 'crop_latitude', 'crop_longitude'] %}{% if key in record %}{% set _ = record.update({key: record[key] | string}) %}{% endif %}{% endfor %}
{#- "Is planning record created?" yes: the land is in Planning, so only Land ID and land area are kept, as on the web form. -#}
{% if record.get('is_planning_record_created') is sameas true %}
  {% for key in ['is_plot_not_registered', 'plot_category', 'ownership_type', 'soil_fertility_type', 'region', 'zone', 'woreda', 'kebele', 'latitude', 'longitude'] %}{% set _ = record.pop(key, none) %}{% endfor %}
{% endif %}

{% set lookup = {'farmer_id': farmer_id, 'fayda_fin': fayda_id if fayda_id | length == 12 else none, 'fayda_fan_id': fayda_id if fayda_id | length == 16 else none, 'status': 'DRAFT', 'lifecycle_stage': 'CULTIVATION'} %}
{% set sections = {'crop_farmer_lookup': [lookup], 'cs_common_intake_season': [{'crop_year': crop_year, 'production_season': production_season}], 'cs_cultivation_details': [record]} %}

{#- Child rows: up to 3 cultivation cluster (Cultivation cluster details) in the same intake, from the cluster_<n>_* columns (n = 1 to 3).
    The file column is the field with the cluster_<n>_ prefix (cluster_1_land_id -> land_id); a field already named
    cluster_* drops that part (cluster_name -> cluster_1_name). A group with any value becomes one row and needs its Land ID; blank
    groups are skipped. Read-only fields are left to the registry. -#}
{% set child = {"section": "cs_cultivation_cluster_details", "label": "Cultivation cluster", "prefix": "cluster_", "strip": "cluster_", "count": 3, "kinds": {"text": ["land_id", "cluster_name", "reference", "season", "sub_kebele", "agro_ecological_zone", "primary_commodity", "secondary_commodity", "water_source", "water_source_method", "water_source_frequency", "leader", "co_leader", "coordinator", "secretary", "da_name", "da_mobile_number", "supervisor_name", "supervisor_mobile_number"], "geo": ["region", "zone", "woreda", "kebele"], "number_text": ["latitude", "longitude"], "number": ["cluster_area_timad", "cluster_plan", "collected_land", "collected_quintal", "collected_by_combiner"], "integer": ["number_of_smallholders"], "date": ["start_gc", "end_gc", "establishing_date"]}, "choices": {"fpc_type": ["GREEN"]}, "aliases": {}, "season": true} %}
{% set child_rows = [] %}
{% for n in range(1, child.count + 1) %}
  {% set item = {} %}{% set ns = namespace(given=false) %}
  {% for kind in ['text', 'geo', 'number_text', 'number', 'integer', 'date'] %}{% for field in child.kinds.get(kind, []) %}
    {% set column = child.prefix ~ n ~ '_' ~ (field[child.strip | length:] if field.startswith(child.strip) else field) %}
    {% set value = cell.get(column, '') %}
    {% if value %}
      {% set ns.given = true %}
      {% if kind == 'text' %}{% set _ = item.update({field: value}) %}
      {% elif kind == 'geo' %}{% set _ = item.update({field: value | upper}) %}
      {% elif kind in ['number', 'number_text'] %}
        {% if not value.replace('.', '', 1).isdigit() %}{{ fail('column ' ~ column ~ ' must be a number, got ' ~ value) }}{% endif %}
        {% set _ = item.update({field: (value if kind == 'number_text' else value | float)}) %}
      {% elif kind == 'integer' %}
        {% if not value.replace('.', '', 1).isdigit() %}{{ fail('column ' ~ column ~ ' must be a whole number, got ' ~ value) }}{% endif %}
        {% set _ = item.update({field: value | float | int}) %}
      {% elif kind == 'date' %}
        {% set day = value[:10] %}{% set parts = day.split('-') %}
        {% if not (parts | length == 3 and parts[0] | length == 4 and parts[1] | length == 2 and parts[2] | length == 2 and (parts | join('')).isdigit()) %}{{ fail('column ' ~ column ~ ' must be a date as YYYY-MM-DD, got ' ~ value) }}{% endif %}
        {% set _ = item.update({field: day}) %}
      {% endif %}
    {% endif %}
  {% endfor %}{% endfor %}
  {% for field, allowed in child.choices.items() %}
    {% set column = child.prefix ~ n ~ '_' ~ (field[child.strip | length:] if field.startswith(child.strip) else field) %}
    {% set value = cell.get(column, '') %}
    {% if value %}
      {% set ns.given = true %}{% set ns.found = none %}
      {% set value = child.aliases.get(value | upper, value) %}
      {% for code in allowed %}{% if code | lower == value | lower %}{% set ns.found = code %}{% endif %}{% endfor %}
      {% if ns.found is none %}{{ fail('column ' ~ column ~ ' must be one of ' ~ allowed | join(', ') ~ ', got ' ~ value) }}{% endif %}
      {% set _ = item.update({field: ns.found}) %}
    {% endif %}
  {% endfor %}
  {% if ns.given %}
    {% if not item.get('land_id') %}{{ fail('column ' ~ child.prefix ~ n ~ '_land_id is required when the row has ' ~ child.label | lower ~ ' ' ~ n) }}{% endif %}
    {#- A cluster's season must be the production season (the registry refuses another one). -#}
    {% if child.season and 'season' not in item %}{% set _ = item.update({'season': production_season}) %}{% endif %}
    {% set _ = child_rows.append(item) %}
  {% endif %}
{% endfor %}
{% if child_rows %}{% set _ = sections.update({child.section: child_rows}) %}{% endif %}

{{ sections | tojson }}
